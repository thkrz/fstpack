!    -*- f90 -*-
! Note: the context of this file is case sensitive.

python module fstpack
    usercode '''
#include <math.h>
'''
    interface
        subroutine local_spectrum(l,m,s,x,y,h)
            integer, optional,intent(in),check(shape(s,0)==l&&shape(s,1)==l),depend(s) :: l=shape(s,0)
            integer, optional,intent(hide),depend(l) :: m=2*((int)log2((double)l))
            complex dimension(l,l),intent(in) :: s
            integer intent(in) :: x
            integer intent(in) :: y
            complex dimension(m,m),intent(out),depend(m) :: h
        end subroutine local_spectrum
        subroutine idost(n,s,h)
            integer, optional,intent(in),check(shape(s,0)==n&&shape(s,1)==n),depend(s) :: n=shape(s,0)
            complex dimension(n,n),intent(in) :: s
            complex dimension(n,n),intent(out),depend(n) :: h
        end subroutine idost
        subroutine dost(n,h,s)
            integer, optional,intent(in),check(shape(h,0)==n&&shape(h,1)==n),depend(h) :: n=shape(h,0)
            complex dimension(n,n),intent(in) :: h
            complex dimension(n,n),intent(out),depend(n) :: s
        end subroutine dost
        subroutine ifst(n,s,h)
            integer, optional,intent(in),check(shape(s,0)==n/2+1&&shape(s,1)==n),depend(s) :: n=2*(shape(s,0)-1)
            complex dimension(n/2+1,n),intent(in) :: s
            complex dimension(n),intent(out),depend(n) :: h
        end subroutine ifst
        subroutine fst(n,h,s)
            integer, optional,intent(in),check(len(h)>=n),depend(h) :: n=len(h)
            complex dimension(n),intent(in) :: h
            complex dimension(n/2+1,n),intent(out),depend(n) :: s
        end subroutine fst
    end interface
end python module fstpack
